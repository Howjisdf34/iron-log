# ─────────────────────────────────────────────────────────────────────────
# Iron Log — variables de entorno
#
# IMPORTANTE (Next.js + Coolify): dos categorías, no las mezcles.
#
#  BUILD-TIME  → sólo las `NEXT_PUBLIC_*` se inyectan en el bundle del
#                cliente, y se congelan en el momento de `next build`.
#                Si cambias una `NEXT_PUBLIC_*` en Coolify DESPUÉS de haber
#                buildeado la imagen, no surte efecto hasta el próximo build.
#                (Con la Opción B de la Fase 7 —build en GitHub Actions—
#                esto significa: el valor tiene que existir como secret en
#                GitHub Actions, no sólo en Coolify.)
#
#  RUNTIME     → todo lo demás (DATABASE_URL, AUTH_SECRET, etc.) se lee en
#                cada arranque del contenedor vía `process.env`. Cambiarlas
#                en Coolify y reiniciar el contenedor es suficiente, sin
#                rebuild.
# ─────────────────────────────────────────────────────────────────────────

# [runtime] Cadena de conexión a Postgres.
#  - Cuando la app corre DENTRO de docker-compose (producción/Coolify): usa
#    "db" (nombre del servicio, resuelve por DNS interno de la red).
#  - Cuando corres `pnpm dev` en el HOST contra la DB de Docker: usa
#    "localhost:5433" y levanta la DB con el overlay de desarrollo:
#      docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
#    (puerto 5433, no 5432, para no chocar con un Postgres nativo local;
#    docker-compose.yml solo, sin el overlay, NO expone el puerto al host
#    — a propósito, ver docs/ARCHITECTURE.md).
DATABASE_URL=postgresql://ironlog:changeme@localhost:5433/ironlog

# [runtime] Credenciales que arma el propio docker-compose.yml para el
# servicio `db` (postgres:17-alpine). Deben coincidir con DATABASE_URL.
POSTGRES_USER=ironlog
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ironlog

# [runtime] Secreto de firma de sesión de Auth.js v5. Genera uno real con:
#   openssl rand -base64 32
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32

# [runtime] URL pública donde vive la app — Auth.js la usa para construir
# callbacks y cookies seguras. En local: http://localhost:3000
AUTH_URL=http://localhost:3000

# [build-time] URL pública de la app, visible en el cliente (fetch absoluto,
# manifest.json, etc.). Debe coincidir con AUTH_URL en la mayoría de casos.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [runtime] Directorio del volumen persistente donde vive la media de
# ejercicios descargada por `pnpm seed:exercises`. En Docker: /app/media
MEDIA_DIR=./media

# [runtime, sólo primer arranque] JSON con los 2 usuarios a crear si la
# tabla de usuarios está vacía. Alternativa a `pnpm user:create` manual.
# Ejemplo: [{"email":"tu@correo.com","password":"...","name":"Tú"}]
SEED_USERS=

# [runtime] Nivel de logs JSON a stdout: debug | info | warn | error
LOG_LEVEL=info

# [sólo pnpm seed:exercises, opcional] Ruta al binario de ffmpeg si no está
# en el PATH del sistema. En el VPS/Docker no hace falta (el seed no corre
# en producción, sólo en tu máquina o en CI).
FFMPEG_PATH=

# [runtime] Zona horaria del contenedor — afecta timestamps de logs y cron
# de backups.
TZ=America/Mexico_City
